# Copy this file to .env and fill in your real keys.
# NEVER commit .env - it's already in .gitignore.

# Anthropic API key (Claude) - used for all text generation modules
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI API key - used for gpt-image-1 character portrait / panel image generation
OPENAI_API_KEY=sk-...

# Port the backend listens on
PORT=8000

# Comma-separated list of origins allowed to call this API (your Vite dev server)
CORS_ORIGIN=http://localhost:5173
