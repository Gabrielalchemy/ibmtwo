# Copy this file to .env and fill in your real keys.
# NEVER commit .env - it's already in .gitignore.

# --- Groq (text generation) ---
# Free key, no card required: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL_ID=llama-3.3-70b-versatile

# --- Image generation: Pollinations.ai (free, no key needed) ---
# Nothing to configure - imageGen.js calls it directly.

# --- 3D character generation: TripoSR (free, open-source, via Hugging Face Space) ---
# Optional but recommended: a free HF token gives you your own daily GPU quota
# instead of the stricter shared/anonymous pool, so generations are more reliable.
# Get one (read-only is fine) at https://huggingface.co/settings/tokens
HF_TOKEN=your-hugging-face-token

# Port the backend listens on
PORT=8000

# Comma-separated list of origins allowed to call this API (your Vite dev server)
CORS_ORIGIN=http://localhost:5173
